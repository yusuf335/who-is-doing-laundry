# Firebase web app config (Project settings -> Your apps -> Web app -> SDK setup)
# Copy this file to .env.local and fill in the values from your own Firebase project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: point the app at the local Firebase emulators instead of the cloud project.
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# Optional abuse protection (recommended once deployed): Firebase App Check with reCAPTCHA v3.
# Console → App Check → register the web app with a reCAPTCHA v3 site key, then enforce for
# Firestore. Locally, add a debug token (App Check → Manage debug tokens) and set it below.
# NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Resend, for the "your cycle is done" reminder. Optional: with no key the app simply
# does not send email. The key must be a server-side secret, so no NEXT_PUBLIC_ prefix.
# RESEND_API_KEY=
# RESEND_FROM=Laundry <laundry@your-verified-domain.com>
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Testing only: routes every reminder to Resend's simulator instead of a housemate.
# delivered@resend.dev, bounced@resend.dev and complained@resend.dev simulate each outcome.
# RESEND_TEST_RECIPIENT=delivered@resend.dev

# Phone notifications (standard Web Push), optional: with no keys the setting says it is
# not set up and nothing is sent. Generate a pair with: npx web-push generate-vapid-keys
# The public key is meant to be public; the private key is a server-side secret.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# A contact the push services can reach if your notifications misbehave.
# VAPID_SUBJECT=mailto:you@example.com

# Upstash QStash delivers each notification at its time (cycle done, booking soon), so
# nothing needs a cron job or a paid Firebase plan. console.upstash.com -> QStash.
# It must be able to reach the app, so NEXT_PUBLIC_APP_URL (above) has to be public https;
# on Vercel the production URL is used when it is unset. Local development skips it.
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
# Only if your QStash account is in another region, e.g. https://qstash-us-east-1.upstash.io
# QSTASH_URL=
